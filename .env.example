# Configure either or both notification providers. Never commit your populated .env file.

# ntfy: create a private topic in the ntfy mobile app, then set its name here.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
# Set to false only on an IPv6-only network. Defaults to IPv4 for reliability.
NTFY_FORCE_IPV4=true

# Home Assistant: a long-lived access token and the notify service suffix.
# Example: notify.mobile_app_your_phone -> HA_NOTIFY_SERVICE=mobile_app_your_phone
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
HA_NOTIFY_SERVICE=

# Required to use POST /api/monitor/test. Generate a long random value.
NOTIFICATION_TEST_TOKEN=replace-with-a-long-random-value

# Logging: use INFO=true for monitor activity, DEBUG=true for per-bus detail.
INFO=false
DEBUG=false

# Optional monitor configuration. All time windows use Asia/Kolkata.
# Separate stops for each schedule. ALERT_STOP_ID remains supported as a fallback.
MORNING_STOP_ID=21945
EVENING_STOP_ID=21702
ALERT_ETA_MINUTES=10
MORNING_ROUTES=314-A,314-B
EVENING_ROUTES=314-A,314-B
